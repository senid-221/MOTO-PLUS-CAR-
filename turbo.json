{
  "$schema": "https://turborepo.com/schema.json",
  "ui": "stream",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": [".next/**", "!.next/cache/**", "dist/**"]
    },
    "@seremoto/prisma-client#build": {
      "dependsOn": ["^build"],
      "outputs": []
    },
    "lint": {},
    "typecheck": {
      "dependsOn": ["^build"]
    },
    "test": {
      "dependsOn": ["^build"]
    },
    "test:e2e": {
      "dependsOn": ["^build"],
      "cache": false,
      "env": [
        "NODE_ENV",
        "DATABASE_URL",
        "DIRECT_DATABASE_URL",
        "JWT_ACCESS_SECRET",
        "JWT_REFRESH_SECRET",
        "ACCESS_TOKEN_TTL",
        "REFRESH_TOKEN_TTL",
        "OTP_TTL_SECONDS",
        "OTP_MAX_ATTEMPTS",
        "SMS_PROVIDER",
        "API_BASE_URL",
        "APP_WEB_URL",
        "CORS_ALLOWED_ORIGINS",
        "SEED_PHONE_PREFIX"
      ]
    },
    "dev": {
      "cache": false,
      "persistent": true
    }
  }
}
