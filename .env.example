# SERE MOTO Rwanda — environment template.
# Copy to .env and fill in real values. Never commit .env (this repository is public).

NODE_ENV=development

# ---------------------------------------------------------------------------
# Database (PostgreSQL). The schema declares both variables, and the Prisma CLI
# refuses to run any migrate command unless both exist, even if only one is
# used. The `prisma:migrate:*` scripts fall back to DATABASE_URL when this is
# unset, so leave it empty for a direct connection and set the non-pooled URL
# whenever DATABASE_URL goes through a pooler (Neon `…-pooler`, Supabase pooler).
# ---------------------------------------------------------------------------
DATABASE_URL=
DIRECT_DATABASE_URL=

# The end-to-end suite refuses a DATABASE_URL that does not contain "test", so
# create a throwaway database (Neon: `seremoto_test`) for `pnpm test:e2e`.
# Development seed accounts are built from this E.164 prefix plus two digits,
# so +2507880000 seeds +250788000001, +250788000002 and so on.
SEED_PHONE_PREFIX=+2507880000

# ---------------------------------------------------------------------------
# Cache and queues. Optional in development: when unset, the API runs jobs
# in-process and logs a warning instead of requiring Redis.
# ---------------------------------------------------------------------------
REDIS_URL=

# ---------------------------------------------------------------------------
# Authentication
# ---------------------------------------------------------------------------
# Generate each with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
ACCESS_TOKEN_TTL=900
REFRESH_TOKEN_TTL=2592000
OTP_TTL_SECONDS=300
OTP_MAX_ATTEMPTS=5

# ---------------------------------------------------------------------------
# HTTP
# ---------------------------------------------------------------------------
API_PORT=4000
API_BASE_URL=http://localhost:4000/api/v1
APP_WEB_URL=http://localhost:3000
# How long the web server waits for one API call before it reports the API as
# unreachable. Raise it when the database is hosted and idles (waking it up costs
# the first request); 30000 is the default when this is unset.
WEB_UPSTREAM_TIMEOUT_MS=30000
# Comma-separated browser origins allowed to send cookies to the API.
CORS_ALLOWED_ORIGINS=http://localhost:3000

# ---------------------------------------------------------------------------
# SMS / OTP delivery.
# log = development stand-in that records the code and never sends anything.
# ---------------------------------------------------------------------------
SMS_PROVIDER=log
# MTN_MOMO=
MTN_BASE_URL=
MTN_SUBSCRIPTION_KEY=
MTN_API_USER=
MTN_API_KEY=
MTN_TARGET_ENVIRONMENT=sandbox

STORAGE_ENDPOINT=
STORAGE_BUCKET=
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=

GOOGLE_MAPS_API_KEY=

FCM_PROJECT_ID=
FCM_CREDENTIALS=

SENTRY_DSN=
