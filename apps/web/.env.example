# SERE MOTO web app — local configuration.
# Copy to .env.local and adjust. Never commit .env.local (this repository is public).

# Where the proxy forwards /api/v1/* to. Keep the /api/v1 suffix.
# The value is only ever read on the server; the browser never sees it.
API_BASE_URL=http://localhost:4000/api/v1

# Public address of this app, used for metadata and absolute redirects.
APP_WEB_URL=http://localhost:3000

# Optional: how long the proxy waits for the API before answering 502.
# WEB_UPSTREAM_TIMEOUT_MS=10000
